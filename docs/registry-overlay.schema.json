{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://imonfhir.com/ns/mcp-registry-overlay/v1.schema.json",
  "$comment": "Rules a registry entry must meet on top of an MCP Registry server.json, which is validated separately against the published schema. 'committedServer' is what a committed entry must also satisfy; 'overlay' is _meta[\"com.imonfhir/registry\"].",
  "definitions": {
    "tier": {
      "description": "One of the Lab's four capability tiers: stable = on everywhere; preview = on in preview deployments, off on production; preview-only = a flag restores the route only; never-public = never.",
      "enum": ["stable", "preview", "preview-only", "never-public"]
    },
    "toolOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": { "type": "boolean", "description": "May only lower the server's value." },
        "tier": { "$ref": "#/definitions/tier" }
      },
      "allOf": [{ "if": { "properties": { "tier": { "const": "never-public" } }, "required": ["tier"] }, "then": { "required": ["public"], "properties": { "public": { "const": false } } } }]
    },
    "safeRemoteUrl": {
      "description": "https only; a host of two or more DNS labels; never localhost, *.local, *.internal, *.localhost, an IPv4 literal (which covers RFC 1918, loopback and link-local) or an IPv6 literal.",
      "type": "string",
      "pattern": "^https://(?!localhost(?:[:/]|$))(?!\\[)(?!(?:\\d{1,3}\\.){3}\\d{1,3}(?:[:/]|$))(?![^/:]*\\.(?:local|internal|localhost)(?:[:/]|$))(?![^/:]*\\.(?:\\d+|0x[0-9a-f]*)(?:[:/]|$))[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+(?::\\d{1,5})?(?:/\\S*)?$"
    },
    "local": {
      "description": "How the laptop console starts the server: the shape of mcp-tool-console's console.config.json entry. No env (keys are named only in an uncommitted local file) and a relative cwd only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "cwd"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "pattern": "^(?![/\\\\~])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).*$" }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "tier", "public", "enabled", "tools"],
      "properties": {
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["browser", "hosted", "local"] } },
        "tier": { "$ref": "#/definitions/tier" },
        "public": { "type": "boolean" },
        "enabled": { "type": "boolean", "description": "Whether imonfhir.com surfaces this server at all; changed only by a reviewed PR." },
        "package": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "The id of the vendored package." },
        "packageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The consumer-side pin the vendor step compares PROVENANCE.json against." },
        "local": { "$ref": "#/definitions/local" },
        "tools": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/toolOverride" } }
      },
      "allOf": [
        { "if": { "properties": { "public": { "const": false } } }, "then": { "properties": { "tools": { "additionalProperties": { "properties": { "public": { "const": false } } } } } } },
        { "if": { "properties": { "tier": { "const": "never-public" } } }, "then": { "properties": { "public": { "const": false } } } },
        { "if": { "required": ["package"] }, "then": { "required": ["packageDigest"] } },
        { "if": { "required": ["packageDigest"] }, "then": { "required": ["package"] } },
        { "if": { "properties": { "modes": { "contains": { "const": "local" } } } }, "then": { "required": ["local"] } },
        {
          "if": { "required": ["enabled", "modes"], "properties": { "enabled": { "const": true }, "modes": { "contains": { "const": "browser" } } } },
          "then": { "required": ["package", "packageDigest"] }
        }
      ]
    },
    "committedServer": {
      "type": "object",
      "required": ["_meta"],
      "properties": {
        "remotes": { "type": "array", "items": { "type": "object", "properties": { "url": { "$ref": "#/definitions/safeRemoteUrl" }, "headers": false } } },
        "packages": { "type": "array", "items": { "type": "object", "properties": { "environmentVariables": false, "transport": { "type": "object", "properties": { "headers": false } } } } },
        "_meta": { "type": "object", "required": ["com.imonfhir/registry"], "properties": { "com.imonfhir/registry": { "$ref": "#/definitions/overlay" } } }
      }
    }
  },
  "$ref": "#/definitions/committedServer"
}
